{
  "name": "gmail-multi-mcp",
  "version": "0.1.0",
  "description": "MCP server for Gmail, Drive and Calendar across multiple Google accounts under a single Google Cloud project.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-drive",
    "google-calendar",
    "google-workspace",
    "google",
    "email",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "gmail-multi-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/drive": "^22.0.0",
    "@googleapis/gmail": "^18.0.0",
    "@googleapis/people": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "open": "^11.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
